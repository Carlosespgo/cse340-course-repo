<%- include('partials/header') %>
    <main>
        <h1><%= category.name %></h1>
        <h2>Service Projects in this Category:</h2>
        <ul>
            <% serviceProjects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </li>
            <% }) %>
        </ul>
        <p><a href="/edit-category/<%= category.category_id %>" class="btn-action btn-edit">Edit Category</a></p>
    </main>
<%- include('partials/footer') %>