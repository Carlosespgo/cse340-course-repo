<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <p>We count with the following categories:</p>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <strong><%= category.name %></strong>
                    </a>
                </li>
            <% }) %>
        </ul>
    </main>
<%- include('partials/footer') %>