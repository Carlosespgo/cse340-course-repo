<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= organizationDetails.org_name %></h2>
    <img class="logo" src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.org_name %> logo">
    <p>Description: <%= organizationDetails.description %></p>
    <h3>Service Projects</h3>
    <ul>
        <% projects.forEach(project => { %>
            <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
        <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>