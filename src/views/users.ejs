<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Role</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                            <td><%= user.name %></td>
                            <td><%= user.role_name %></td>
                            <td><%= user.email %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>
<%- include('partials/footer') %>