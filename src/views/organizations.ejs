<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <p>Here are a few of our partner organizations:</p>
        <ul>
            <% organizations.forEach(organization => { %>
            <li>
                <img class="logo" src="/images/<%= organization.logo_filename %>" alt="<%= organization.org_name %> logo">
                <div class="organization-info">
                    <strong><a href="/organization/<%= organization.id_organization %>"><%= organization.org_name %></a></strong>
                    <span><%= organization.contact_email %></span>
                </div>
            </li>
            <% }); %>
        </ul>
        <p><a href="/new-organization">Add a new organization</a></p>
    </main>
<%- include('partials/footer') %>