<%- include('partials/header') %>
    <main>
        <h1><%= project.title %></h1>
        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>
        <p>
            <strong>Date:</strong>
            <%= project.project_date.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    }) %>
        </p>
        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>
        <p>
            <strong>Partner Organization:</strong>
            <a href="/organization/<%= project.id_organization %>">
                <%= project.org_name %>
            </a>
        </p>
        <p>
            <strong>Categories:</strong>
            <% if (categories.length > 0) { %>
                <% categories.forEach(category => { %>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                <% }) %>
            <% } else { %>
                No categories assigned.
            <% } %>
        </p>
        <% if (user) { %>
            <% if (project.isVolunteer) { %>
                <p>You are volunteering for this project.</p>
                <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                    <button type="submit" class="btn-unvolunteer">Unvolunteer</button>
                </form>
            <% } else { %>
                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit" class="btn-volunteer">Volunteer</button>
                </form>
            <% } %>
        <% } %> 
        <% if (user && user.role_name === 'admin') { %>
            <p><a href="/assign-categories/<%= project.project_id %>" class="btn-action btn-edit">Edit Categories</a></p>
            <p><a href="/edit-project/<%= project.project_id %>" class="btn-action btn-edit">Edit Project</a></p>
        <% } %>
    </main>
<%- include('partials/footer') %>